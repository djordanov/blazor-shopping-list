@page "/"
@page "/shopping-list"
@page "/shopping-list/{id:guid}"
@using Microsoft.EntityFrameworkCore
@using ShoppingListApp.Components.Partials
@using ShoppingListApp.Data
@using ShoppingListApp.Entities
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>@ShoppingList?.Name</PageTitle>

<div id="shopping-list-header" data-mode="default">
    <select id="shopping-list-select" onchange="window.location = this.value">
        <ShoppingListOptionComponent IsSelected="@false"></ShoppingListOptionComponent>
        @foreach (var shoppingList in AllShoppingLists)
        {
            <ShoppingListOptionComponent ShoppingList="@shoppingList" IsSelected="@(shoppingList.Id == Id)"></ShoppingListOptionComponent>
        }
    </select>
    
    <!-- controls for default mode -->
    <div id="shopping-list-default-controls">
        <button type="button" class="secondary" disabled="@(ShoppingList is null)"
                onclick="document.getElementById('shopping-list-header').setAttribute('data-mode', 'edit')">
            <i class="ti ti-edit"></i>
        </button> 
        <button type="button" class="secondary" aria-label="Add shopping list"
                onclick="document.getElementById('shopping-list-header').setAttribute('data-mode', 'add')">
            <i class="ti ti-plus"></i>
        </button>
    </div>
    
    <!-- controls for add mode -->
    <form id="add-shopping-list-form" hx-post="/htmx/shopping-list" hx-swap="append" hx-target="select"
          hx-on:htmx:after:request="this.reset();
                document.getElementById('shopping-list-header').setAttribute('data-mode', 'default');">
        <input name="name" placeholder="..." aria-required="true"/>
        <button type="submit">
            <i class="ti ti-check"></i>
        </button>
        <button type="reset"
                onclick="document.getElementById('shopping-list-header').setAttribute('data-mode', 'default')">
            <i class="ti ti-x"></i>
        </button>
    </form>
    
    <!-- controls for edit mode -->
    <form id="edit-shopping-list-form" hx-patch="/htmx/shopping-list/@ShoppingList?.Id" hx-swap="none">
        <input name="name" value="@(ShoppingList?.Name)" aria-required="true"/>
        <button type="submit">
            <i class="ti ti-check"></i>
        </button>
        <button type="reset"
                onclick="document.getElementById('shopping-list-header').setAttribute('data-mode', 'default')">
            <i class="ti ti-x"></i>
        </button>
        <button type="button" class="secondary" hx-confirm="Are you sure you want to delete @ShoppingList?.Name"
                hx-delete="/htmx/shopping-list/@ShoppingList?.Id">
            <i class="ti ti-trash"></i>
        </button>
    </form>
</div>

@if (ShoppingList is not null)
{
    <div id="shopping-list-stage-selectors">
        <button type="button" aria-label="Shop"
                onclick="document.getElementById('shopping-list-body').toggleAttribute('data-shopping-view');
                    this.toggleAttribute('aria-pressed');
                    this.classList.toggle('contrast');">
            <i class="ti ti-shopping-cart"></i>
            <span>SHOP</span>
        </button>
        <button type="button" command="show-modal" commandfor="buy-dialog" aria-label="Buy"
                hx-get="/htmx/shopping-list/@ShoppingList?.Id/buy" hx-target="#buy-dialog > article" hx-swap="innerHTML">
            <i class="ti ti-credit-card"></i>
            <span>BUY</span>
        </button>
    </div>
}

@if(ShoppingList is not null)
{
    <div id="shopping-list-body">
        <div id="sections">
            @foreach (var section in ShoppingList?.Sections ?? [])
            {
                <SectionComponent ShoppingListId="(Guid)Id!" Section="section" Items="section.ListItems"></SectionComponent>
            }
        </div>
        <button type="submit" aria-label="Add section"
                hx-post="/htmx/shopping-list/@ShoppingList!.Id/section" hx-swap="append" hx-target="#sections">
            <i class="ti ti-plus"></i>
            <span>ADD SECTION</span>
        </button>
    </div>
    <dialog id="buy-dialog" closedby="any">
        <article>
            <p>Loading ...</p>
        </article>
    </dialog>
}


@code {
    [Parameter] public Guid? Id { get; set; }
    private ShoppingList? ShoppingList { get; set; }
    private List<ShoppingList> AllShoppingLists { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        AllShoppingLists = await db.ShoppingList.OrderBy(sl => sl.Name).ToListAsync();
        
        ShoppingList = await db.ShoppingList
            .Include(sl => sl.Sections.OrderBy(s => s.CreatedAt))
            .Include(sl => sl.ListItems.OrderBy(i => i.SortOrder))
            .FirstOrDefaultAsync(sl => sl.Id == Id);
    }
}
