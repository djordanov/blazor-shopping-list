@page "/"
@page "/shopping-list"
@page "/shopping-list/{id:guid}"
@using Microsoft.EntityFrameworkCore
@using ShoppingListApp.Components.Partials
@using ShoppingListApp.Data
@using ShoppingListApp.Entities
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>@ShoppingList?.Name</PageTitle>

<div id="shopping-list-header" data-mode="default">
    <select class="show-on-default" onchange="window.location = this.value">
        <ShoppingListOption IsSelected="@false"></ShoppingListOption>
        @foreach (var shoppingList in AllShoppingLists)
        {
            <ShoppingListOption ShoppingList="@shoppingList" IsSelected="@(shoppingList.Id == Id)"></ShoppingListOption>
        }
    </select>
    
    <!-- controls for default mode -->
    <button type="button" class="show-on-default" disabled="@(ShoppingList is null)"
            onclick="document.getElementById('shopping-list-header').setAttribute('data-mode', 'edit')">
        <i class="ti ti-edit"></i>
    </button> 
    <button type="button" class="show-on-default" aria-label="Add shopping list"
            onclick="document.getElementById('shopping-list-header').setAttribute('data-mode', 'add')">
        <i class="ti ti-plus"></i>
    </button>
    
    <!-- controls for add mode -->
    <form id="create-shopping-list-form" hx-post="/htmx/shopping-list" hx-swap="append" hx-target="select"
          hx-on:htmx:after:request="this.reset();
                document.getElementById('shopping-list-header').setAttribute('data-mode', 'default');">
        <input class="show-on-add" name="name" placeholder="..." aria-required="true"/>
        <button type="submit" class="show-on-add">
            <i class="ti ti-check"></i>
        </button>
        <button type="reset" class="show-on-add"
                onclick="document.getElementById('shopping-list-header').setAttribute('data-mode', 'default')">
            <i class="ti ti-x"></i>
        </button>
    </form>
    
    <!-- controls for edit mode -->
    <form id="edit-shopping-list-form" class="show-on-edit" hx-patch="/htmx/shopping-list/@ShoppingList?.Id" hx-swap="none"
          hx-on:htmx:after:request="window.location = '/shopping-list/@ShoppingList?.Id'"> <!-- updating the shopping list name inside the select would be a hassle -->
        <input class="show-on-edit" name="name" value="@(ShoppingList?.Name)" aria-required="true"/>
        <button type="submit" class="show-on-edit">
            <i class="ti ti-check"></i>
        </button>
        <button type="reset" class="show-on-edit" 
                onclick="document.getElementById('shopping-list-header').setAttribute('data-mode', 'default')">
            <i class="ti ti-x"></i>
        </button>
        <button type="button" class="show-on-edit secondary" hx-confirm="Are you sure you want to delete @ShoppingList?.Name"
                hx-delete="/htmx/shopping-list/@ShoppingList?.Id" hx-on:htmx:after:request="window.location = '/'">
            <i class="ti ti-trash"></i>
        </button>
    </form>
</div>

@if (ShoppingList is not null)
{
    <div id="shopping-list-stage-selectors">
        <a role="button" href="/shopping-list/@ShoppingList?.Id?stage=note">
            <i class="ti ti-pencil"></i> NOTE
        </a>
        <a role="button" href="/shopping-list/@ShoppingList?.Id?stage=shop">
            <i class="ti ti-shopping-cart"></i> SHOP
        </a>
        <a role="button" href="/shopping-list/@ShoppingList?.Id?stage=pay">
            <i class="ti ti-credit-card"></i> BUY
        </a>
    </div>
}

@if(ShoppingList is not null)
{
    <div id="sections">
        @foreach (var section in ShoppingList?.Sections ?? [])
        {
            <SectionComponent ShoppingListId="(Guid)Id!" Section="section" Items="section.ListItems"></SectionComponent>
        }

        @if (ItemsWithoutSection.Any())
        {
            <SectionComponent ShoppingListId="(Guid)Id!" Items="(ShoppingList?.ListItems ?? []).Where(i => i.Section == null).ToList()"></SectionComponent>
        }
    </div>

    <button type="submit" aria-label="Add section"
            hx-post="/htmx/shopping-list/@ShoppingList!.Id/section" hx-swap="append" hx-target="#sections">
        <i class="ti ti-plus"></i>
    </button>
}


@code {
    [Parameter] public Guid? Id { get; set; }
    private ShoppingList? ShoppingList { get; set; }
    private List<ShoppingList> AllShoppingLists { get; set; } = [];
    private List<Item> ItemsWithoutSection { get; set; } = [];
    [SupplyParameterFromQuery] public string Stage { get; set; } = "note";

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        AllShoppingLists = await db.ShoppingList.OrderBy(sl => sl.Name).ToListAsync();
        
        ShoppingList = await db.ShoppingList
            .Include(sl => sl.Sections)
            .Include(sl => sl.ListItems)
            .FirstOrDefaultAsync(sl => sl.Id == Id);

        ItemsWithoutSection = (ShoppingList?.ListItems ?? []).Where(i => i.SectionId == null).ToList();
    }
}
