@page "/shopping-list"
@page "/shopping-list/{id:guid}"
@using Microsoft.EntityFrameworkCore
@using ShoppingListApp.Components.Partials
@using ShoppingListApp.Data
@using ShoppingListApp.Entities
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>@ShoppingList?.Name</PageTitle>

<div>
    <select onchange="window.location = this.value">
        <option value="/shopping-list/">-- Select a Shopping List --</option>
        @foreach (var shoppingList in AllShoppingLists)
        {
            <ShoppingListOption ShoppingList="@shoppingList" IsSelected="@(shoppingList == ShoppingList)"></ShoppingListOption>
        }
    </select>
    
    <form method="post" @formname="create-shopping-list"
          hx-post="/shopping-list" hx-swap="append" hx-target="select"
          hx-on:htmx:after:request="this.reset()">
        <span>Add new Shopping List</span>
        <label for="name">Name:</label>
        <input name="name" aria-required="true"/>
        <button type="submit">SUBMIT</button>
        <AntiforgeryToken></AntiforgeryToken>
    </form>
    
    @if (ShoppingList is not null)
    {
        <button
            hx-delete="/shopping-list/@ShoppingList?.Id" hx-confirm="Are you sure you want to delete @ShoppingList?.Name"
            hx-on:htmx:after:request="window.location = '/shopping-list'">DELETE</button>
    }
</div>

@if(ShoppingList is not null)
{
    <form method="post" @formname="create-section"
          hx-post="/shopping-list/@ShoppingList.Id/section" hx-swap="append" hx-target="#sections"
          hx-on:htmx:after:request="this.reset()">
        <label for="name">Section Name:</label>
        <input id="name" name="name" aria-required="true"/>
        <button type="submit">SUBMIT</button>
        <AntiforgeryToken></AntiforgeryToken>
    </form>
}

<div id="sections">
    @foreach (var section in ShoppingList?.Sections ?? [])
    {
        <SectionComponent ShoppingListId="(Guid)Id!" Section="section" Items="section.ListItems"></SectionComponent>
    }

    @if (ItemsWithoutSection.Any())
    {
        <SectionComponent ShoppingListId="(Guid)Id!" Items="(ShoppingList?.ListItems ?? []).Where(i => i.Section == null).ToList()"></SectionComponent>
    }
</div>


@code {
    [Parameter] public Guid? Id { get; set; }
    private ShoppingList? ShoppingList { get; set; }
    private List<ShoppingList> AllShoppingLists { get; set; } = [];
    private List<ListItem> ItemsWithoutSection { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        AllShoppingLists = await db.ShoppingList.ToListAsync();
        
        ShoppingList = await db.ShoppingList
            .Include(sl => sl.Sections)
            .Include(sl => sl.ListItems)
            .ThenInclude(i => i.Item)
            .FirstOrDefaultAsync(sl => sl.Id == Id);

        ItemsWithoutSection = (ShoppingList?.ListItems ?? []).Where(i => i.SectionId == null).ToList();
    }
}
