@page "/"
@page "/shopping-list"
@page "/shopping-list/{id:guid}"
@using Microsoft.EntityFrameworkCore
@using ShoppingListApp.Components.Partials
@using ShoppingListApp.Data
@using ShoppingListApp.Entities
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>@(ShoppingList?.Name ?? "Shopping List")</PageTitle>

<div id="shopping-list-header" data-mode="default">
    <select id="shopping-list-select" onchange="window.location = this.value">
        <ShoppingListOptionComponent IsSelected="@false"></ShoppingListOptionComponent>
        @foreach (var shoppingList in AllShoppingLists)
        {
            <ShoppingListOptionComponent ShoppingList="@shoppingList" IsSelected="@(shoppingList.Id == Id)"></ShoppingListOptionComponent>
        }
    </select>
    
    <!-- controls for default mode -->
    <div id="shopping-list-default-controls">
        <button type="button" class="secondary" disabled="@(ShoppingList is null)"
                onclick="document.getElementById('shopping-list-header').setAttribute('data-mode', 'edit')">
            <i class="ti ti-edit"></i>
        </button> 
        <button type="button" class="secondary" aria-label="Add shopping list"
                onclick="document.getElementById('shopping-list-header').setAttribute('data-mode', 'add')">
            <i class="ti ti-plus"></i>
        </button>
    </div>
    
    <!-- controls for add mode -->
    <form id="add-shopping-list-form" method="post"
          @formname="AddShoppingListForm" @onsubmit="AddShoppingList">
        <input name="NewListName" placeholder="Supermarket" aria-required="true"/>
        <button type="submit">
            <i class="ti ti-check"></i>
        </button>
        <button type="reset"
                onclick="document.getElementById('shopping-list-header').setAttribute('data-mode', 'default')">
            <i class="ti ti-x"></i>
        </button>
        <AntiforgeryToken></AntiforgeryToken>
    </form>
    
    <!-- controls for edit mode -->
    <form id="edit-shopping-list-form" method="post"
          @formname="EditShoppingListForm" @onsubmit="EditShoppingList">
        <input name="EditListName" value="@(ShoppingList?.Name)" aria-required="true"/>
        <button type="submit">
            <i class="ti ti-check"></i>
        </button>
        <button type="reset"
                onclick="document.getElementById('shopping-list-header').setAttribute('data-mode', 'default')">
            <i class="ti ti-x"></i>
        </button>
        <AntiforgeryToken></AntiforgeryToken>
    </form>
    
    <form id="delete-shopping-list-form" method="post"
          @formname="DeleteShoppingListForm" @onsubmit="DeleteShoppingList">
        <button type="submit" class="secondary" onclick="return confirm('Are you sure you want to delete this list?')">
            <i class="ti ti-trash"></i>
        </button>
        <AntiforgeryToken></AntiforgeryToken>
    </form>
</div>

@if (ShoppingList is not null)
{
    <div id="shopping-list-stage-selectors">
        <button type="button" aria-label="Shop"
                onclick="document.getElementById('shopping-list-body').toggleAttribute('data-shopping-view');
                    this.toggleAttribute('aria-pressed');
                    this.classList.toggle('contrast');">
            <i class="ti ti-shopping-cart"></i>
            <span>SHOP</span>
        </button>
        <button type="button" command="show-modal" commandfor="buy-dialog" aria-label="Buy">
            <i class="ti ti-credit-card"></i>
            <span>BUY</span>
        </button>
    </div>
}

@if(ShoppingList is not null)
{
    <div id="shopping-list-body">
        <div id="sections" data-shopping-list-id="@ShoppingList.Id">
            @foreach (var section in ShoppingList?.Sections ?? [])
            {
                <SectionComponent ShoppingListId="(Guid)Id!" Section="section" Items="section.ListItems"></SectionComponent>
            }
        </div>
        <form @formname="AddSectionForm" @onsubmit="AddSection" method="post">
            <button type="submit" aria-label="Add section">
                <i class="ti ti-plus"></i>
                <span>ADD SECTION</span>
            </button>
            <AntiforgeryToken></AntiforgeryToken>
        </form>
    </div>
    <dialog id="buy-dialog" closedby="any">
        <article>
            <BuyModalComponent ShoppingList="ShoppingList"></BuyModalComponent>
        </article>
    </dialog>
}


@code {
    [Parameter] public Guid? Id { get; set; }
    private ShoppingList? ShoppingList { get; set; }
    private List<ShoppingList> AllShoppingLists { get; set; } = [];

    [SupplyParameterFromForm(FormName="AddShoppingListForm")] private string? NewListName { get; init; }
    [SupplyParameterFromForm(FormName="EditShoppingListForm")] private string? EditListName { get; init; }
    
    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        AllShoppingLists = await db.ShoppingList
            .AsNoTracking()
            .Include(sl => sl.Sections.OrderBy(s => s.SortOrder))
            .Include(sl => sl.ListItems.OrderBy(i => i.SortOrder))
            .OrderBy(sl => sl.Name).ToListAsync();
        
        ShoppingList = await db.ShoppingList
            .Include(sl => sl.Sections.OrderBy(s => s.SortOrder))
            .Include(sl => sl.ListItems.OrderBy(i => i.SortOrder))
            .FirstOrDefaultAsync(sl => sl.Id == Id);
    }

    private async Task AddShoppingList()
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(NewListName);
        
        var shoppingList = new ShoppingList
        {
            Name = NewListName
        };
    
        await using var db = await DbFactory.CreateDbContextAsync();
        db.ShoppingList.Add(shoppingList);
        await db.SaveChangesAsync();
        
        NavigationManager.Refresh();
    }
    
    private async Task EditShoppingList()
    {
        ArgumentNullException.ThrowIfNull(ShoppingList);
        ArgumentException.ThrowIfNullOrWhiteSpace(EditListName);
        
        await using var db = await DbFactory.CreateDbContextAsync();
        ShoppingList.Name = EditListName;
        db.ShoppingList.Update(ShoppingList);
        await db.SaveChangesAsync();
        
        NavigationManager.Refresh();
    }
    
    private async Task DeleteShoppingList()
    {
        ArgumentNullException.ThrowIfNull(ShoppingList);
        
        await using var db = await DbFactory.CreateDbContextAsync();
        db.ShoppingList.Remove(ShoppingList);
        await db.SaveChangesAsync();
        
        NavigationManager.NavigateTo("/shopping-list/");
    }

    private async Task AddSection()
    {
        ArgumentNullException.ThrowIfNull(ShoppingList);
        
        await using var db = await DbFactory.CreateDbContextAsync();
        var section = new Section
        {
            ShoppingListId = ShoppingList.Id,
            Name = ""
        };
    
        db.Section.Add(section);
        await db.SaveChangesAsync();
        NavigationManager.Refresh();
    }
}
