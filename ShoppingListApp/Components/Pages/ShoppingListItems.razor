@page "/"
@page "/shopping-list"
@page "/shopping-list/{id:guid}"
@using Microsoft.EntityFrameworkCore
@using ShoppingListApp.Components.Partials
@using ShoppingListApp.Data
@using ShoppingListApp.Entities
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>@ShoppingList?.Name</PageTitle>

<div id="shopping-list-header">
    <select onchange="window.location = this.value">
        <option value="/shopping-list/"><h1>-- Select a Shopping List --</h1></option>
        @foreach (var shoppingList in AllShoppingLists)
        {
            <ShoppingListOption ShoppingList="@shoppingList" IsSelected="@(shoppingList.Id == Id)"></ShoppingListOption>
        }
    </select>
    
    <div>
        <form id="create-shopping-list-form" method="post" @formname="create-shopping-list"
              hx-post="/htmx/shopping-list" hx-swap="append" hx-target="select"
              hx-on:htmx:after:request="this.reset()">
            <input name="name" placeholder="Add New" aria-required="true"/>
            <button type="submit" aria-label="Add shopping list"><i class="ti ti-plus"></i></button>
            <AntiforgeryToken></AntiforgeryToken>
        </form>
        
        @if (ShoppingList is not null)
        {
            <button
                hx-delete="/htmx/shopping-list/@ShoppingList?.Id" hx-confirm="Are you sure you want to delete @ShoppingList?.Name"
                hx-on:htmx:after:request="window.location = '/shopping-list'"><i class="ti ti-trash"></i></button>
        }
    </div>
</div>

@if(ShoppingList is not null)
{
    <div id="sections">
        @foreach (var section in ShoppingList?.Sections ?? [])
        {
            <SectionComponent ShoppingListId="(Guid)Id!" Section="section" Items="section.ListItems"></SectionComponent>
        }

        @if (ItemsWithoutSection.Any())
        {
            <SectionComponent ShoppingListId="(Guid)Id!" Items="(ShoppingList?.ListItems ?? []).Where(i => i.Section == null).ToList()"></SectionComponent>
        }
    </div>

    <form id="create-section-form" method="post" @formname="create-section"
          hx-post="/htmx/shopping-list/@ShoppingList.Id/section" hx-swap="append" hx-target="#sections"
          hx-on:htmx:after:request="this.reset()">
        <input id="name" name="name" placeholder="Add Section" aria-required="true"/>
        <button type="submit" aria-label="Add section"><i class="ti ti-plus"></i></button>
        <AntiforgeryToken></AntiforgeryToken>
    </form>
}


@code {
    [Parameter] public Guid? Id { get; set; }
    private ShoppingList? ShoppingList { get; set; }
    private List<ShoppingList> AllShoppingLists { get; set; } = [];
    private List<Item> ItemsWithoutSection { get; set; } = [];

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        AllShoppingLists = await db.ShoppingList.ToListAsync();
        
        ShoppingList = await db.ShoppingList
            .Include(sl => sl.Sections)
            .Include(sl => sl.ListItems)
            .FirstOrDefaultAsync(sl => sl.Id == Id);

        ItemsWithoutSection = (ShoppingList?.ListItems ?? []).Where(i => i.SectionId == null).ToList();
    }
}
