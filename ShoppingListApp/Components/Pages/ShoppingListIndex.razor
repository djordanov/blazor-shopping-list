@page "/shopping-list"
@using Microsoft.EntityFrameworkCore
@using ShoppingListApp.Components.Partials
@using ShoppingListApp.Data
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Shopping List</PageTitle>

<h1>Shopping List</h1>

<h3>ADD NEW</h3>
<form method="post" @formname="create-shopping-list"
    hx-post="/shopping-list" hx-select=".shopping-list-card" hx-swap="append" hx-target="#list"
    hx-on:htmx:after:request="this.reset()">
    <label for="name">Name:</label>
    <input id="name" name="name" aria-required="true"/>
    <button type="submit">SUBMIT</button>
    <AntiforgeryToken></AntiforgeryToken>
</form>

@if(IsHtmxPost)
{
    <ShoppingListRow ShoppingList="NewShoppingList" />
    return;
}

<div id="list">
    @foreach (var shoppingList in ShoppingLists)
    {
        <ShoppingListRow ShoppingList="shoppingList" />
    }
</div>

@code {
    private bool IsHtmxPost { get; set; }

    private Entities.ShoppingList? NewShoppingList { get; set; }

    private List<Entities.ShoppingList> ShoppingLists { get; set; } = [];

    [CascadingParameter] HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        if (HttpContext?.Request.Headers.ContainsKey("HX-Request") == true)
        {
            ShoppingLists = await db.ShoppingList.ToListAsync();
            return;
        }

        var form = HttpContext is not null ? await HttpContext.Request.ReadFormAsync() : null;
        var name = form?["name"].ToString();
        if (string.IsNullOrWhiteSpace(name))
        {
            throw new Exception();
        }

        if (HttpMethods.IsPost(HttpContext?.Request.Method ?? ""))
        {
            NewShoppingList = new Entities.ShoppingList
            {
                Name = name
            };
            db.ShoppingList.Add(NewShoppingList);
        }

        if (HttpMethods.IsPut(HttpContext?.Request.Method ?? ""))
        {
            var id = form?["id"].ToString();
            if (string.IsNullOrWhiteSpace(id))
            {
                throw new Exception();
            }

            var shoppingList = new Entities.ShoppingList
            {
                Id = new Guid(id),
                Name = name
            };
            db.Add(shoppingList);
        }
        
        await db.SaveChangesAsync();       
    }
}
