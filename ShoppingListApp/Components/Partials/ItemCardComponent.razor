@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using ShoppingListApp.Data
@using ShoppingListApp.Entities
@inject IDbContextFactory<AppDbContext> DbFactory

@if(Item is not null)
{
    <div class="item-card sortable-handler" data-mode="@Mode" data-status="@Item.ItemStatus">
        <ItemStatusButton Item="Item" OnClickCallback="IncrementStatus"></ItemStatusButton>
        <form @onsubmit="EditItem" @onsubmit:preventDefault="true">
            <span class="item-name" @onclick="EnterEditMode">@Item.Name</span>
            <input class="item-name" type="text" @bind="EditItemName"/>
            <button type="submit">
                <i class="ti ti-check"></i>
            </button>
            <button type="reset" @onclick="ExitEditMode" @onclick:preventDefault="true">
                <i class="ti ti-x"></i>
            </button>
        </form>
        <form class="item-delete-form" @onsubmit="DeleteItem" @onsubmit:preventDefault="true">
            <button type="submit" class="secondary">
                <i class="ti ti-trash"></i>
            </button>
        </form>
        <ItemCountStepperComponent Item="@Item"></ItemCountStepperComponent>
    </div>   
}

@code {
    [Parameter, EditorRequired] public required Guid ItemId { get; set; }
    private string Mode { get; set; } = "default";
    public Item? Item { get; set; }
    [SupplyParameterFromForm] private string? EditItemName { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        Item = await db.Item.FindAsync(ItemId);

        EditItemName = Item?.Name;
        if (string.IsNullOrEmpty(Item?.Name))
        {
            Mode = "edit";
        }
    }
    
    private async Task IncrementStatus()
    {
        ArgumentNullException.ThrowIfNull(Item);
        
        var nextStatus = Item.GetNextItemStatus(Item.ItemStatus);
        Item.ItemStatus = nextStatus;
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Item.Update(Item);
        await db.SaveChangesAsync();
    }

    private void EnterEditMode()
    {
        Mode = "edit";
    }

    private void ExitEditMode()
    {
        Mode = "default";
    }

    private async Task EditItem()
    {
        ArgumentNullException.ThrowIfNull(Item);
        
        await using var db = await DbFactory.CreateDbContextAsync();
        Item.Name = EditItemName ?? "";
        db.Item.Update(Item);
        await db.SaveChangesAsync();
        ExitEditMode();
    }
    
    private async Task DeleteItem()
    {
        ArgumentNullException.ThrowIfNull(Item);
        
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Item.Remove(Item);
        await db.SaveChangesAsync();
        Item = null;
    }
}
