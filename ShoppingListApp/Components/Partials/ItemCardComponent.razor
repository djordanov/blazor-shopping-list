@using ShoppingListApp.Entities

<div class="item-card sortable-handler" data-mode="@Mode" data-status="@Item.ItemStatus"
     hx-patch="/htmx/shopping-list/@ShoppingListId/item/@Item.Id" hx-trigger="end" hx-swap="none">
    
    <!-- for POST by sortable -->
    <input type="hidden" name="Id" value="@Item.Id"/>
    
    <form hx-patch="/htmx/shopping-list/@ShoppingListId/item/@Item.Id"
          hx-target="closest .item-card" hx-swap="outerHTML">
        <ItemStatusButton ShoppingListId="ShoppingListId" Item="Item"></ItemStatusButton>
        <span class="item-name" onclick="this.closest('.item-card').setAttribute('data-mode', 'edit')">@Item.Name</span>
        <input class="item-name" type="text" name="Name" value="@Item.Name"/>
        <button type="submit">
            <i class="ti ti-check"></i>
        </button>
        <button type="reset" onclick="this.closest('.item-card').setAttribute('data-mode', 'default')">
            <i class="ti ti-x"></i>
        </button>
        <button type="button" class="secondary" hx-delete="/htmx/shopping-list/@ShoppingListId/item/@Item.Id"
                hx-swap="outerHTML" hx-target="closest .item-card" aria-label="Delete item">
            <i class="ti ti-trash"></i>
        </button>
    </form>
    <ItemCountStepperComponent ShoppingListId="ShoppingListId" Item="Item"></ItemCountStepperComponent>
</div>   

@code {
    [Parameter, EditorRequired] public required Guid ShoppingListId { get; set; }
    [Parameter, EditorRequired] public required Item Item { get; set; }
    [Parameter] public string Mode { get; set; } = "default";

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(Item.Name))
        {
            Mode = "edit";
        }
    }
}
