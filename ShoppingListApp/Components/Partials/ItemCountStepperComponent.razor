@using ShoppingListApp.Entities

<div class="item-count-stepper">
    <button type="button" disabled="@(Item.Count < 1)"
            hx-patch="/htmx/shopping-list/@ShoppingListId/item/@Item.Id" hx-target="closest .item-card" hx-swap="outerHTML"
            hx-vals="js:{'CountDelta': -1}">
        <i class="ti ti-minus"></i>    
    </button>
    <span>@Item.Count</span>
    <button type="button"
            hx-patch="/htmx/shopping-list/@ShoppingListId/item/@Item.Id" hx-target="closest .item-card" hx-swap="outerHTML"
            hx-vals="js:{'CountDelta': +1}">
        <i class="ti ti-plus"></i>
    </button>
</div>

@code {
    [Parameter, EditorRequired] public required Guid ShoppingListId { get; set; }
    [Parameter, EditorRequired] public required Item Item { get; set; }
}