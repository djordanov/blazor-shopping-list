@using ShoppingListApp.Entities

<article id="@ArticleId" class="shopping-list-card">
    <p>@ShoppingList?.Name</p>
    <button hx-delete="/shopping-list/@ShoppingList?.Id" hx-swap="outerHTML" hx-target="closest article">DELETE</button>
</article>

@code {
    [Parameter] public ShoppingList? ShoppingList { get; set; }
    [Parameter] public string? Id { get; set; }
    private string? ArticleId { get; set; }

    public override Task SetParametersAsync(ParameterView parameters)
    {
        ArticleId = Id ?? ShoppingList?.Id.ToString();
        
        return base.SetParametersAsync(parameters);
    }
}