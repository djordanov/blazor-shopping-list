@using Microsoft.EntityFrameworkCore
@using ShoppingListApp.Data
@using ShoppingListApp.Entities
@inject IDbContextFactory<AppDbContext> DbFactory

@{
    var (icon, ariaLabel) = FromStatus(Item.ItemStatus);
}

<button type="button" class="secondary outline item-status-button" aria-label="@ariaLabel" @onclick="IncrementStatus">
    <i class="@icon"></i>
</button>

@code {
    [Parameter, EditorRequired] public required Item Item { get; set; }

    private async Task IncrementStatus()
    {
        ArgumentNullException.ThrowIfNull(Item);
        
        var nextStatus = Item.GetNextItemStatus(Item.ItemStatus);

        var db = await DbFactory.CreateDbContextAsync();
        await db.Item
            .Where(i => i.Id == Item.Id)
            .ExecuteUpdateAsync(setters => setters.SetProperty(item => item.ItemStatus, nextStatus));
        Item.ItemStatus = nextStatus;
    }

    private static (string icon, string ariaLabel) FromStatus(ItemStatus itemStatus) => itemStatus switch
    {
        ItemStatus.Noted => ("ti ti-square-rounded", "Mark item as planned"),
        ItemStatus.Planned => ("ti ti-square-rounded-minus", "Mark item as collected"),
        ItemStatus.Collected => ("ti ti-square-rounded-check", "Mark item as noted"),
        _ => throw new ArgumentOutOfRangeException()
    };
}
