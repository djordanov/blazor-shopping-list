@using ShoppingListApp.Entities

@{
    string icon;
    string ariaLabel;
    
    switch (Item.ItemStatus)
    {
        case ItemStatus.Noted:
            icon = "ti ti-square-rounded";
            ariaLabel = "Mark item as planned";
            break;
        case ItemStatus.Planned:
            icon = "ti ti-square-rounded-minus";
            ariaLabel = "Mark item as collected";
            break;
        case ItemStatus.Collected:
            icon = "ti ti-square-rounded-check";
            ariaLabel = "Mark item as noted";
            break;
        default:
            throw new ArgumentOutOfRangeException();
    }
}

<button type="button" class="secondary outline item-status-button" data-item-status="@Item.ItemStatus" aria-label="@ariaLabel">
    <i class="@icon"></i>
</button>

@code {
    [Parameter, EditorRequired] public required Guid ShoppingListId { get; set; }
    [Parameter, EditorRequired] public required Item Item { get; set; }
}
