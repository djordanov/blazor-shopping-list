@using Microsoft.EntityFrameworkCore
@using ShoppingListApp.Data
@using ShoppingListApp.Entities
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager

<form @formname="BuyForm" @onsubmit="Buy" method="post">
    <b>Are you sure you bought the following items?</b>
    <p>Your shopping list will be reset for the next trip!</p>
    @foreach (var section in ShoppingList.Sections ?? [])
    {
        var items = ShoppingList!.ListItems
            .Where(i => i.SectionId == section.Id && i.ItemStatus == ItemStatus.Collected)
            .ToList();
        if (items.Count > 0)
        {
            <strong>@section.Name</strong>
            <ul>
                @foreach (var item in items)
                {
                    <li>@item.Count @item.Name</li>
                }   
            </ul>
        }
    }
    
    <button type="submit">
        <i class="ti ti-check"></i>
        <span>DONE</span>
    </button>
    <AntiforgeryToken></AntiforgeryToken>
</form>

@code {
    [Parameter, EditorRequired] public ShoppingList ShoppingList { get; init; }

    private async Task Buy()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        
        var collectedItems = await db.Item
            .Where(i => i.ShoppingListId == ShoppingList.Id && i.ItemStatus == ItemStatus.Collected)
            .ToListAsync();
        foreach (var item in collectedItems)
        {
            item.ItemStatus = ItemStatus.Noted;
        }

        await db.SaveChangesAsync();
        NavigationManager.NavigateTo($"/shopping-list/{ShoppingList.Id}", forceLoad: true);
    }
}
