@using ShoppingListApp.Entities

@if (Item is null)
{
    <form method="post" @formname="create-item"
          hx-post="/htmx/shopping-list/@ShoppingListId/item" hx-swap="append" hx-target="closest article"
          hx-on:htmx:after:request="this.reset()">
        <input class="item-name" name="name" placeholder="Add New" aria-required="true"/>
        <input type="hidden" name="sectionId" value="@SectionId" />
        <button type="submit">SUBMIT</button>
        <AntiforgeryToken></AntiforgeryToken>
    </form>
}
else
{
    <div class="item-card">
        <div>
            <input class="item-name" type="text" name="Item.Name" value="@Item.Name"
                   hx-patch="/htmx/shopping-list/@ShoppingListId/item/@Item.Id" hx-swap="none" hx-trigger="change delay:500ms"/>
        </div>
        <div>
            <input type="number" name="Item.Count" value="@Item.Count"
                   hx-patch="/htmx/shopping-list/@ShoppingListId/item/@Item.Id" hx-swap="none"/>
            @* ReSharper disable once Html.AttributeValueNotResolved *@
            <input role="switch" type="checkbox" checked="@Item.IsCollected" hx-vals="js:{'Item.IsCollected': event.target.checked}"
                   hx-patch="/htmx/shopping-list/@ShoppingListId/item/@Item.Id" hx-swap="none"/>
            <button hx-delete="/htmx/shopping-list/@ShoppingListId/item/@Item.Id"
                    hx-swap="outerHTML" hx-target="closest .item-card">DELETE</button>
        </div>
    </div>   
}

@code {
    [Parameter] public Guid ShoppingListId { get; set; }
    [Parameter] public Guid? SectionId { get; set; }
    [Parameter] public Item? Item { get; set; }    
}
