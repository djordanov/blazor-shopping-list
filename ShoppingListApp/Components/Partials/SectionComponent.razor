@using ShoppingListApp.Entities

<article class="section">
    @if (Section is not null)
    {   
        <header>
            <input type="text" name="Section.Name" value="@Section.Name"
                   hx-patch="/htmx/shopping-list/@ShoppingListId/section/@Section.Id"
                   hx-swap="none" hx-trigger="change delay:500ms"/>
            <button hx-delete="/htmx/shopping-list/@ShoppingListId/section/@Section.Id" 
                hx-swap="outerHTML" hx-target="closest article" aria-label="Delete section"><i class="ti ti-trash"></i></button>
        </header>
    }
    <div id="section-@Section?.Id-items">
        @foreach (var item in Items.Where(i => i.SectionId == Section?.Id))
        {
            <ItemCardComponent Stage="Stage" ShoppingListId="ShoppingListId" SectionId="Section?.Id" Item="item"></ItemCardComponent>
        }
    </div>
    <ItemCardComponent Stage="Stage" ShoppingListId="ShoppingListId" SectionId="Section?.Id"></ItemCardComponent>
</article>

@code {
    [Parameter] public Guid ShoppingListId { get; set; }
    [Parameter] public Section? Section { get; set; }
    [Parameter] public required List<Item> Items { get; set; }
    [SupplyParameterFromQuery] public string Stage { get; set; } = "note";
}
