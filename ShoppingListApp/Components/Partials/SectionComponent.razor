@using Microsoft.EntityFrameworkCore
@using ShoppingListApp.Data
@using ShoppingListApp.Entities
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager NavigationManager

<article class="section">
    <input type="hidden" name="Section.Id" value="@Section.Id"/>
    <header data-mode="@Mode">
        <!-- default mode -->
        <span class="sortable-handler" onclick="this.closest('header').setAttribute('data-mode', 'edit')">@Section.Name</span>

        <!-- controls for edit mode -->
        <form class="section-edit-form"
              hx-patch="/htmx/shopping-list/@ShoppingListId/section/@Section.Id" hx-swap="outerHTML" hx-target="closest .section">
            <input type="text" name="Section.Name" value="@Section.Name"/>
            <button type="submit">
                <i class="ti ti-check"></i>
            </button>
            <button type="reset" onclick="this.closest('header').setAttribute('data-mode', 'default')">
                <i class="ti ti-x"></i>
            </button>
            <button type="button" class="secondary" hx-delete="/htmx/shopping-list/@ShoppingListId/section/@Section.Id"
                    hx-swap="outerHTML" hx-target="closest .section" aria-label="Delete section"
                    hx-confirm="Are you sure you want to delete section @Section.Name with all it's items?">
                <i class="ti ti-trash"></i>
            </button>
        </form>
    </header>

    <div id="section-@Section.Id-items" class="items"
         hx-trigger="add consume, update consume delay: 200ms" hx-swap="none"
         hx-post="/htmx/shopping-list/@ShoppingListId/section/@Section.Id/sort">
        @foreach (var item in Items.Where(i => i.SectionId == Section?.Id))
        {
            <ItemCardComponent ShoppingListId="ShoppingListId" Item="item"></ItemCardComponent>
        }
    </div>
    <form @formname="AddItemForm" @onsubmit="AddItem" method="post">
        <button type="submit" aria-label="Add item">
            <i class="ti ti-plus"></i>
            <span>ADD ITEM</span>
        </button>
    </form>

</article>

@code {
    [Parameter, EditorRequired] public required Guid ShoppingListId { get; set; }
    [Parameter, EditorRequired] public required Section Section { get; set; }
    [Parameter, EditorRequired] public required List<Item> Items { get; set; }
    [Parameter] public string Mode { get; set; } = "default";
    [SupplyParameterFromForm(FormName="AddItemForm")] private string? NewItemName { get; init; }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(Section.Name))
        {
            Mode = "edit";
        }
    }

    private async Task AddItem()
    {
        ArgumentException.ThrowIfNullOrWhiteSpace(NewItemName);
        
        await using var db = await DbFactory.CreateDbContextAsync();
        var item = new Item
        {
            ShoppingListId = ShoppingListId,
            SectionId = Section.Id,
            Name = NewItemName
        };
    
        db.Item.Add(item);
        await db.SaveChangesAsync();
        NavigationManager.Refresh();
    }
}
