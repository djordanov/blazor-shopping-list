@using Microsoft.EntityFrameworkCore
@using ShoppingListApp.Data
@using ShoppingListApp.Entities
@inject IDbContextFactory<AppDbContext> DbFactory

@if (Section is not null)
{
    <article class="section" data-section-id="@Section?.Id">
        <header data-mode="@Mode">
            <!-- default mode -->
            <span class="sortable-handler" @onclick='() => Mode = "edit"'>@Section?.Name</span>
            <!-- controls for edit mode -->
            <form class="section-edit-form" @onsubmit="EditSection" @onsubmit:preventDefault="true">
                <input type="text" @bind="EditSectionName"/>
                <button type="submit">
                    <i class="ti ti-check"></i>
                </button>
                <button type="reset" @onclick='() => Mode = "default"' @onclick:preventDefault="true">
                    <i class="ti ti-x"></i>
                </button>
                <AntiforgeryToken></AntiforgeryToken>
            </form>
            <form class="section-delete-form" @onsubmit="DeleteSection" @onsubmit:preventDefault="true">
                <button type="submit" class="secondary" onclick="return confirm('Are you sure you want to delete this section?')">
                    <i class="ti ti-trash"></i>
                </button>
                <AntiforgeryToken></AntiforgeryToken>
            </form>
        </header>

        <div class="items">
            @foreach (var item in Items.Where(i => i.SectionId == Section.Id))
            {
                <ItemCardComponent Item="@item"></ItemCardComponent>
            }
        </div>
        <form @onsubmit="AddItem" @onsubmit:preventDefault="true">
            <button type="submit" aria-label="Add item">
                <i class="ti ti-plus"></i>
                <span>ADD ITEM</span>
            </button>
            <AntiforgeryToken></AntiforgeryToken>
        </form>
    </article>
}

@code {
    [Parameter, EditorRequired] public required Guid ShoppingListId { get; set; }
    [Parameter, EditorRequired] public required Section? Section { get; set; }
    [Parameter, EditorRequired] public required List<Item> Items { get; set; }
    [Parameter] public string Mode { get; set; } = "default";
    [SupplyParameterFromForm] private string? EditSectionName { get; set; }
    [SupplyParameterFromForm] private string? NewItemName { get; init; }

    protected override void OnParametersSet()
    {
        EditSectionName = Section?.Name;
        if (string.IsNullOrEmpty(Section?.Name))
        {
            Mode = "edit";
        }
    }
    
    private async Task EditSection()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        Section = await db.Section.FindAsync(Section?.Id);
        ArgumentNullException.ThrowIfNull(Section);
        ArgumentException.ThrowIfNullOrWhiteSpace(EditSectionName);
        
        Section.Name = EditSectionName;
        await db.SaveChangesAsync();
    }

    private async Task DeleteSection()
    {
        ArgumentNullException.ThrowIfNull(Section);
        await using var db = await DbFactory.CreateDbContextAsync();
        db.Section.Remove(Section);
        await db.SaveChangesAsync();
    }
    
    private async Task AddItem()
    {
        ArgumentNullException.ThrowIfNull(Section);
        await using var db = await DbFactory.CreateDbContextAsync();
        var item = new Item
        {
            ShoppingListId = ShoppingListId,
            SectionId = Section.Id,
            Name = NewItemName ?? ""
        };
    
        db.Item.Add(item);
        await db.SaveChangesAsync();
    }
}
